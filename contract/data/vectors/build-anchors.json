      "expected": [
        {
          "kind": "factor",
          "factor": 0.5,
          "label": "Petite"
        },
        {
          "kind": "factor",
          "factor": 1,
          "label": "1 part"
        },
        {
          "kind": "factor",
          "factor": 1.5,
          "label": "Grande"
        },
        {
          "kind": "factor",
          "factor": 2,
          "label": "Double"
        }
      ]
    },
    {
      "id": "weight-mode-ignores-an-available-item-unit",
      "why": "An item unit is used only when servingMode says so. Cheese sold by the piece is still scaled by weight if Knowledge says weight.",
      "input": {
        "basePortionG": 74,
