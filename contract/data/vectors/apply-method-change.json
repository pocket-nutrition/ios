          },
          "imageUrl": null,
          "servingMode": "weight"
        },
        "newMethod": "raw"
      },
      "expected": {
        "id": "rice-fixture",
        "label": "riz",
        "ingredientId": "rice",
        "cookingMethod": "raw",
        "quantity": 38,
        "unit": "g",
