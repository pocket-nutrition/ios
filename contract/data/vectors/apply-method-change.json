        "basePortionG": 75,
        "portionFactor": 0.5,
        "servingUnits": [],
        "selectedUnit": null,
        "unitCount": 1,
        "displayUnit": "g",
        "canEatRaw": false,
        "yieldFactors": {
          "cooked": 0.85
        },
        "imageUrl": null,
        "servingMode": "weight"
      }
    },
