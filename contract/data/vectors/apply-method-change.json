{
  "suite": "apply-method-change",
  "description": "Re-derives the weight when the user changes cooking method. Branch order matters and is part of the contract: (1) target \"raw\" — from a portion factor recompute base * factor, else invert the current yield if the weight was cooked, else leave it alone; (2) a portion factor is present — recompute from the base and force the result cooked; (3) the weight was cooked — convert through the raw equivalent, leaving measuredState untouched; (4) otherwise only the method changes. `id` is supplied in the input here, so it is asserted too.",
  "generatedBy": "pocket-nutrition-sandbox — npm run vectors:build",
  "cases": [
    {
      "id": "to-raw-from-a-portion-factor",
      "why": "With a portion factor the raw weight is authoritative: 75 g base * 1 = 75 g, discarding the 64 g cooked weight entirely rather than inverting it.",
      "input": {
        "ingredient": {
          "id": "rice-fixture",
          "label": "riz",
          "ingredientId": "rice",
          "cookingMethod": "boiled",
          "quantity": 64,
          "unit": "g",
          "measuredState": "cooked",
          "basePortionG": 75,
          "portionFactor": 1,
          "servingUnits": [],
          "selectedUnit": null,
          "unitCount": 1,
          "displayUnit": "g",
          "canEatRaw": false,
          "yieldFactors": {
            "cooked": 0.85
          },
          "imageUrl": null,
          "servingMode": "weight"
        },
        "newMethod": "raw"
      },
      "expected": {
        "id": "rice-fixture",
        "label": "riz",
        "ingredientId": "rice",
        "cookingMethod": "raw",
        "quantity": 75,
        "unit": "g",
        "measuredState": "raw",
        "basePortionG": 75,
        "portionFactor": 1,
        "servingUnits": [],
        "selectedUnit": null,
        "unitCount": 1,
        "displayUnit": "g",
        "canEatRaw": false,
        "yieldFactors": {
          "cooked": 0.85
        },
        "imageUrl": null,
        "servingMode": "weight"
      }
    },
    {
      "id": "to-raw-from-a-half-portion-factor-hits-a-tie",
      "why": "A rounding tie on a user-reachable path: 75 * 0.5 = 37.5 exactly, so the half-up rule gives 38. Any port that rounds this differently disagrees with the app on a value the user can produce by tapping \"Demi\".",
      "input": {
        "ingredient": {
          "id": "rice-fixture",
          "label": "riz",
          "ingredientId": "rice",
          "cookingMethod": "boiled",
          "quantity": 64,
          "unit": "g",
          "measuredState": "cooked",
          "basePortionG": 75,
          "portionFactor": 0.5,
          "servingUnits": [],
          "selectedUnit": null,
          "unitCount": 1,
          "displayUnit": "g",
          "canEatRaw": false,
          "yieldFactors": {
